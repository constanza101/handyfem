# Copia este archivo a .env.local y rellena los valores reales.
# .env.local está en .gitignore — nunca se sube al repo.
# Los scripts se ejecutan con: node --env-file=.env.local docs/handyfem-jira-*.js

# Credenciales de Atlassian para los scripts de Jira (docs/handyfem-jira-*.js).
# Token: Atlassian → Manage account → Security → API tokens
JIRA_EMAIL=
JIRA_API_TOKEN=
