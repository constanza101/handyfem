# Copy this file to .env.local and fill in the real values.
# .env.local is git-ignored — it never reaches the repo.

# ── Supabase (Project Settings → Data API / API Keys) ──────────────────────
# URL and publishable key are safe in the browser (RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key BYPASSES RLS — server-only (lib/supabase/admin.ts), never expose.
SUPABASE_SECRET_KEY=

# Canonical site URL for auth email links (e.g. https://handyfem.com).
# Optional in local dev (falls back to request headers / localhost:3000),
# REQUIRED in production — never derive email links from request headers.
NEXT_PUBLIC_SITE_URL=

# ── Atlassian credentials for the Jira scripts (docs/handyfem-jira-*.js) ───
# Run with: node --env-file=.env.local docs/handyfem-jira-*.js
# Token: Atlassian → Manage account → Security → API tokens
JIRA_EMAIL=
JIRA_API_TOKEN=
